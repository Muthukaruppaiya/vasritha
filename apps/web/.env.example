# Local PostgreSQL (pgAdmin: database=vasritha, owner=postgres)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/vasritha
USE_LOCAL_POSTGRES=true
JWT_SECRET=vasritha-local-dev-secret-change-me

# Optional later (Supabase cloud)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-server-only-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000
