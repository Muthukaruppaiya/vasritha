# Local PostgreSQL (pgAdmin: database=vasritha, owner=postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vasritha
USE_LOCAL_POSTGRES=true
JWT_SECRET=vasritha-local-dev-secret-change-me

# Optional later (Supabase cloud)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-server-only-secret

# Customer website (Vasritha) — canonical URL for links / SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000

# Domain split (production). Leave empty locally so / and /admin share one port.
# Example:
#   NEXT_PUBLIC_SITE_URL=https://vasritha.in
#   OPS_PUBLIC_URL=https://sukadhaa.in
#   STOREFRONT_HOSTS=vasritha.in,www.vasritha.in
#   OPS_HOSTS=sukadhaa.in,www.sukadhaa.in
# OPS_PUBLIC_URL=https://sukadhaa.in
# STOREFRONT_HOSTS=vasritha.in,www.vasritha.in
# OPS_HOSTS=sukadhaa.in,www.sukadhaa.in

# Optional: notify company email when a review is submitted
# (falls back to site_settings.support_email)
# ADMIN_NOTIFY_EMAIL=hello@vasritha.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Vasritha <noreply@vasritha.com>"
